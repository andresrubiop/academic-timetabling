# Academic AI Planning Platform — environment template
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development
TZ=America/Guayaquil

# ---------------------------------------------------------------------------
# PostgreSQL (internal Docker network only — never publish 5432 publicly)
# Host is bound to 127.0.0.1 for local dev access only.
# ---------------------------------------------------------------------------
POSTGRES_DB=academic_ai
POSTGRES_USER=academic_ai_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql+psycopg://academic_ai_app:replace-with-a-strong-password@db:5432/academic_ai

# ---------------------------------------------------------------------------
# Redis (internal Docker network only)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6381
# SESSION 8: Redis requires a password. An unauthenticated Redis on a shared
# host is a remote-code-execution primitive, not just a cache -- CONFIG SET
# dir + SAVE writes attacker-controlled files as the redis user. Bound to
# 127.0.0.1 as well, but the password is the control that does not depend on
# a firewall nobody could verify.
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_INTERNAL_PORT=8000
BACKEND_SECRET_KEY=replace-with-a-unique-value-generated-by-openssl-rand-hex-32
BACKEND_ALLOWED_HOSTS=127.0.0.1,localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://127.0.0.1:5070,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
FRONTEND_INTERNAL_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5070/api/v1

# ---------------------------------------------------------------------------
# Reverse proxy (nginx) — single published host port for this project.
# Chosen to avoid conflicts with other services already running on this
# shared server (80, 8000, 8090, 8180 are taken — see ARCHITECTURE.md).
# ---------------------------------------------------------------------------
WEB_PORT=5070

# ---------------------------------------------------------------------------
# Optimizer worker (OR-Tools CP-SAT + LNS)
# ---------------------------------------------------------------------------
OPTIMIZER_WORKER_CONCURRENCY=2
OPTIMIZER_DEFAULT_TIME_LIMIT_SECONDS=60

# ---------------------------------------------------------------------------
# AI Model Registry (placeholders — no model is active by default)
# ---------------------------------------------------------------------------
AI_MODEL_REGISTRY_ENABLED=true
AI_DEFAULT_MODEL_STATUS=DISABLED
